{
  "permission-reviewer": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|read_url_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./permission-reviewer.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
