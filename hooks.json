{
  "permission-reviewer": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|grep_search|list_dir|find_by_name|view_file_outline|view_code_item|read_url_content|search_web",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./permission-reviewer.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
